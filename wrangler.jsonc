{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kaszino-kifizetes-24-oran-belul-com",
  "main": "_worker.js",
  "compatibility_date": "2026-09-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
